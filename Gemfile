source "https://rubygems.org"

# Core
gem "jekyll", "~> 4.4"

# Theme (local gem — reproducible builds, no codeload.github.com dependency)
gem "minimal-mistakes-jekyll"

# AsciiDoc support
gem "jekyll-asciidoc"
gem "asciidoctor"

# Jekyll plugins (must match _config.yml)
gem "jekyll-sitemap"
gem "jekyll-feed"
gem "jekyll-include-cache"

# Runtime / platform deps
gem "webrick"
gem "tzinfo-data"
